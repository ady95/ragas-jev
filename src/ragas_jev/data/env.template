# RAGAS-JEV settings. Created by `ragas-jev init`; fill in the keys below.
# Environment variables with the same names take precedence over this file.
# Never commit this file once it holds real keys.

# --- Generative LLM: claim/statement extraction and LLM re-judging ---
# Any OpenAI-compatible endpoint. Leave OPENAI_BASE_URL empty for the OpenAI API.
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Optional: models you expect the endpoint to serve (checked by `ragas-jev healthcheck`).
# AVAILABLE_MODELS=gpt-6-luna,gpt-6-sol

# --- JEV (TypeSafe System One API) ---
TYPESAFE_API_KEY=
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# Pin a version (not jev-latest) so calibrated thresholds stay valid.
TYPESAFE_DEFAULT_MODEL=jev-1.13.0
JEV_TIMEOUT_SEC=30
JEV_MAX_CONCURRENCY=8
JEV_MAX_QUESTIONS_PER_REQUEST=40
# Keep at info or lower: debug logs request/response bodies unredacted.
# TYPESAFE_LOG_LEVEL=info

# --- Routing thresholds ---
# Unset (default) = per-metric routing policies from the Phase 5 benchmark.
# Setting both applies one policy to every metric.
# RAGAS_JEV_CONF_ACCEPT=0.85
# RAGAS_JEV_CONF_AUDIT=0.60
RAGAS_JEV_DECISION_THRESHOLD=0.5

# --- Models per role (empty preprocessor model = OPENAI_MODEL) ---
RAGAS_JEV_PREPROCESSOR_MODEL=
# Auditor: re-judges uncertain JEV decisions. Strong judge: re-judges the least certain ones.
RAGAS_JEV_AUDITOR_MODEL=gpt-6-luna
RAGAS_JEV_STRONG_JUDGE_MODEL=gpt-6-sol
RAGAS_JEV_BASELINE_JUDGE_MODEL=gpt-6-sol

# --- Data protection / storage ---
# Text sent to the LLM and JEV leaves your environment; PII masking runs first.
RAGAS_JEV_PII_MASKING=true
RAGAS_JEV_CACHE_DIR=.cache/ragas_jev
