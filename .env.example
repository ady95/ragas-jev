# Copy to .env and fill in secrets. Never commit .env.

# --- Generative LLM (openai-oauth proxy; upstream is outside the country) ---
OPENAI_BASE_URL=http://<proxy-host>:<port>/v1
OPENAI_API_KEY=not-needed
OPENAI_MODEL=gpt-5.6-luna
AVAILABLE_MODELS=gpt-6-astra,gpt-6-sol,gpt-6-luna,gpt-5.6-sol,gpt-5.6-terra,gpt-5.6-luna,gpt-5.5

# --- JEV (TypeSafe System One API; outside the country) ---
TYPESAFE_API_KEY=
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# Pin a version (not jev-latest) so calibrated thresholds stay valid.
TYPESAFE_DEFAULT_MODEL=jev-1.13.0
JEV_TIMEOUT_SEC=30
JEV_MAX_CONCURRENCY=8
JEV_MAX_QUESTIONS_PER_REQUEST=40
# Keep at info or lower: debug logs request/response bodies unredacted.
# TYPESAFE_LOG_LEVEL=info

# --- Routing thresholds (calibrate in Phase 5) ---
RAGAS_JEV_CONF_ACCEPT=0.85
RAGAS_JEV_CONF_AUDIT=0.60
RAGAS_JEV_DECISION_THRESHOLD=0.5

# --- Models per role (empty preprocessor model = OPENAI_MODEL) ---
RAGAS_JEV_PREPROCESSOR_MODEL=
# Auditor: re-judges uncertain JEV decisions. Baseline: LLM judge JEV is benchmarked against.
RAGAS_JEV_AUDITOR_MODEL=gpt-6-luna
RAGAS_JEV_STRONG_JUDGE_MODEL=gpt-6-astra
RAGAS_JEV_BASELINE_JUDGE_MODEL=gpt-6-sol

# --- Data protection / storage ---
RAGAS_JEV_PII_MASKING=true
RAGAS_JEV_CACHE_DIR=.cache/ragas_jev
